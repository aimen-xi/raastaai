# Copy to .env (or set in your shell) and fill in real values locally. Never commit .env.
# Placeholder values only. tools/serve_public.py generates the two secrets for you on first run
# (stored in secrets/runtime.json, which is git-ignored).

# --- API (api/app/config.py) ---
TICKET_SECRET=change-me-long-random-string     # HMAC key for AI classification tickets
IP_HASH_SALT=change-me-long-random-string      # salt for hashing client IPs (rate limits)
FIREBASE_KEY_PATH=secrets/firebase-admin.json  # Firebase service-account key file (never commit)
FIREBASE_SERVICE_ACCOUNT_JSON=                 # alternative: the key's JSON content (hosted deploys)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500
STORE=                                         # set to "memory" to run without Firebase
MODEL_DIR=api/models
MODEL_THREADS=2

# --- Admin dashboard (admin/, Vite) ---
VITE_API_BASE=http://localhost:7860            # optional: pin the API instead of reading Firestore public/config

# --- Citizen app (Flutter --dart-define) ---
# API_BASE=http://localhost:7860               # optional: flutter run --dart-define=API_BASE=...
# DEMO_SAMPLES=true                            # show the staged sample photos on the home screen
